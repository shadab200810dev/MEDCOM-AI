{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MEDCOM website",
      "type": "process",
      "command": "bash",
      "args": ["run_medcom.sh"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", "run_medcom.bat"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
